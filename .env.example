# Environment Configuration

# Application
APP_NAME=DEV-lldp-topomon
APP_DEBUG=false
# DEBUG 會多出「為什麼這個鄰居沒被自動發現」那一類的行（見
# docs/TROUBLESHOOTING_LLDP.md 第 6 種情況）。認不得的值退回 INFO
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-to-random-string

# Database
DATABASE_URL=postgresql://topomon:password@db:5432/topomon

# Redis
REDIS_URL=redis://redis:6379

# SNMP Settings
SNMP_DEFAULT_COMMUNITY=public
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Collector Settings
#
# Two loops, two intervals. This one is the *inventory* interval: what is
# cabled to what, how fast each port is, which devices are new. That only
# changes when somebody moves a cable, so it can be slow.
COLLECTOR_INTERVAL=300
#
# This one is the fast loop: whether a device answers, whether each cable's
# port is up, how much traffic it carries - and the alert checks. It reads
# three values per cable instead of walking the interface tables, so a cycle
# costs about an eighth of an inventory cycle. It decides:
#   1. how late an alert can be (about half of this, plus the exchange)
#   2. the averaging window of every bps, so the shortest event that can
#      cross a 70% threshold is 0.70 * this (60s -> 42s of line rate)
# Set to 0 to switch it off and put everything back on the inventory loop;
# per-cable link state is then only available from traps.
# See docs/PERFORMANCE.md section 20.
COLLECTOR_FAST_INTERVAL=60
# How many devices wait on SNMP at once, shared by both loops. An SNMP knob
# only - the database half barely responds to it (PERFORMANCE.md 17.4)
COLLECTOR_CONCURRENT=20
# Split the fleet across several collector processes: this one polls the
# devices whose id modulo COLLECTOR_SHARDS is COLLECTOR_SHARD_ID. A cycle is
# CPU bound on SNMP decoding and the GIL means threads do not help, so this is
# how the collector scales past one core.
#
# Three things to know before using it (PERFORMANCE.md section 24):
#   * every shard needs the same COLLECTOR_SHARDS, and every id from 0 to
#     COLLECTOR_SHARDS-1 has to be running - otherwise those devices are
#     polled by nobody, and the only symptom is that they alert as offline.
#     The process holding the fleet-wide lease warns about it.
#   * rebuilding merged_links and running the alert checks happen on exactly
#     one shard (whichever holds the lease), not on all of them
#   * COLLECTOR_TRAP_ENABLED can only be true on one process per host: one
#     process gets udp/162, and it applies traps for the whole fleet
# Measured on a 400 device fleet and scaled to 500: an inventory cycle costs
# 33s of CPU on one process, 18s on each of two, 11s on each of four - a
# 1.86x and 3.05x speedup, for 7% and 27% more CPU on the host in total.
COLLECTOR_SHARDS=1
COLLECTOR_SHARD_ID=0
# Devices that keep not answering are backed off exponentially instead of
# costing a full timeout every cycle
COLLECTOR_OFFLINE_BACKOFF=true
COLLECTOR_OFFLINE_BACKOFF_MAX=1800
# Read ifHCIn/OutOctets so every cable carries a real bps and utilisation.
# Off still reads ifHighSpeed (the real port speed), it just does not measure
# traffic.
COLLECTOR_TRAFFIC_STATS=true
# How long a neighbour that cannot be turned into a device (IP phone,
# printer, AP with SNMP off) is left alone before it is probed again
COLLECTOR_DISCOVERY_CACHE_TTL=3600

# Walk each device's own IP address table during the inventory poll and
# remember what it holds, so a trap is matched to the device that sent it
# whichever interface it left by - which is what makes an
# `snmp-server trap-source` line on every device unnecessary
# (docs/CONFIGURATION.md section 5.3). The walk costs about 5% more CPU for a
# device's poll, and COLLECTOR_ADDRESS_INTERVAL below decides how often it is
# paid (docs/PERFORMANCE.md sections 37 and 38).
#
# Deliberately NOT tied to COLLECTOR_TRAP_ENABLED: only one process per host
# can hold udp/162, so under sharding the one with the receiver needs the
# addresses of devices the other shards poll, and those have traps off.
COLLECTOR_DEVICE_ADDRESSES=true

# Receive SNMP traps (udp/162). linkDown/linkUp then updates that cable's
# state and raises its alert within milliseconds instead of at the next fast
# cycle. Off by default: it opens a listening port, needs the privilege to
# bind below 1024, and receives nothing until the devices are configured to
# send traps here.
#
# A trap is never the only source of truth - one UDP datagram can be lost,
# duplicated, delayed or forged - so the fast loop re-establishes the state
# either way. Only traps from an address a managed device is known to hold,
# with a valid community, about a port that has a cable on it are acted on.
# SNMPv3 notifications are not supported.
#
# "From an address a managed device holds" covers more than the address you
# poll it on: the inventory walk records every address a device reports for
# itself (COLLECTOR_DEVICE_ADDRESSES below), so a device that sends traps
# from its egress interface needs no trap-source line. See
# docs/CONFIGURATION.md section 5.3, and 5.4 for reading the Traps: line when
# nothing arrives.
COLLECTOR_TRAP_ENABLED=false
COLLECTOR_TRAP_BIND=0.0.0.0
COLLECTOR_TRAP_PORT=162
# Accepted communities, comma separated. Empty = SNMP_DEFAULT_COMMUNITY
COLLECTOR_TRAP_COMMUNITIES=

# -- Alert damping ------------------------------------------------------------
# Every alert here comes from a UDP exchange, so a lost or forged datagram can
# raise one. SNMP_RETRIES is the first defence (three attempts per request);
# these are the second. The defaults below reproduce the behaviour that
# existed before they were added, so turning them on is a deliberate choice of
# "later but surer" over "immediate".

# Consecutive unanswered polls before a device is called offline. 1 = the
# first one does it (the original behaviour). 3 with a 60s fast loop means a
# device has to be silent for about 3 minutes, so a congested uplink that eats
# all three SNMP attempts of one cycle no longer pages anybody.
# Measured: with a 20s fast interval, device_offline arrives 99s after the
# device dies at 3 and 24s at 1 (PERFORMANCE.md section 28).
ALERT_OFFLINE_CONFIRM_CYCLES=1

# A cable that changes state this many times inside ALERT_LINK_FLAP_WINDOW
# seconds is flapping: its link_down alert is then held open through the ups
# instead of being resolved and re-raised once per flap, and says so. The
# first down is never delayed. 0 switches it off (one alert and one recovery
# per flap, as before).
ALERT_LINK_FLAP_TRANSITIONS=0
ALERT_LINK_FLAP_WINDOW=600

# Whether a linkDown/linkUp trap waits for the next fast cycle to agree with
# it before its alert is raised. false (the default) is what traps are for:
# the notification alerts in milliseconds. true keeps that state write - the
# topology and the UI are current immediately - and lets the poll decide about
# the alert, which costs up to one fast interval and means a lost, stale or
# forged trap can never page anybody. Per device, the alert profile overrides
# it with {"trap": {"requires_poll": true}}.
# It needs the fast loop: with COLLECTOR_FAST_INTERVAL=0 nothing polls
# per-cable state, so there is nothing to confirm a trap with and the
# collector logs a warning and alerts immediately.
ALERT_TRAP_REQUIRES_POLL=false

# Log Export (Optional)
LOG_EXPORT_ENABLED=false
LOG_EXPORT_TYPE=elasticsearch

# Elasticsearch (if LOG_EXPORT_TYPE=elasticsearch)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=topomon-

# Graylog GELF (if LOG_EXPORT_TYPE=graylog)
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12201
GRAYLOG_PROTOCOL=udp
