# Environment Configuration

# Application
APP_NAME=DEV-lldp-topomon
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-to-random-string

# Database
DATABASE_URL=postgresql://topomon:password@db:5432/topomon

# Redis
REDIS_URL=redis://redis:6379

# SNMP Settings
SNMP_DEFAULT_COMMUNITY=public
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Collector Settings
COLLECTOR_INTERVAL=300
COLLECTOR_CONCURRENT=20
# 連續無回應的設備改用指數退避，不要每輪都等滿 timeout
COLLECTOR_OFFLINE_BACKOFF=true
COLLECTOR_OFFLINE_BACKOFF_MAX=1800
# 讀取 ifHCIn/OutOctets，讓每條線路有真實的 bps 與使用率。
# 關掉仍然會讀 ifHighSpeed（真實埠速），只是不量流量，每台每輪少兩次表走訪。
COLLECTOR_TRAFFIC_STATS=true
# 無法轉成設備的鄰居（沒有管理位址、DNS 查不到、SNMP 不回應，例如 IP 話機、
# 印表機）隔多久才再試一次，避免每輪都重複 DNS 與 SNMP 探測
COLLECTOR_DISCOVERY_CACHE_TTL=3600

# Log Export (Optional)
LOG_EXPORT_ENABLED=false
LOG_EXPORT_TYPE=elasticsearch

# Elasticsearch (if LOG_EXPORT_TYPE=elasticsearch)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=topomon-

# Graylog GELF (if LOG_EXPORT_TYPE=graylog)
GRAYLOG_HOST=graylog
GRAYLOG_PORT=12201
GRAYLOG_PROTOCOL=udp
