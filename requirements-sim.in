# The SNMP agent the tests talk to, locked separately on purpose.
#
# snmpsim pulls pysnmp 7.x, and this project pins pysnmp <7 precisely
# because 7.x renamed the hlapi entry points (requirements.in). In one
# environment the simulator's pysnmp would replace the one under test, so the
# tests would no longer exercise the locked version at all - and on older
# snmpsim releases the same clash arrives as pysnmp-lextudio, a second
# distribution installing into the same "pysnmp" directory. Either way the
# simulator belongs in its own virtualenv, talking to the tests over UDP the
# way a real device does:
#
#   python -m venv .venv-sim
#   .venv-sim/bin/pip install --require-hashes -r requirements-sim.txt
#   SNMPSIM_BIN=.venv-sim/bin/snmpsim-command-responder pytest tests
#
# Regenerate with:
#
#   pip-compile --generate-hashes --strip-extras requirements-sim.in
#
snmpsim>=1.1.0
# snmpsim 1.2.2 imports pysmi in snmpsim/utils.py without declaring it, so a
# clean install of snmpsim alone dies with ModuleNotFoundError: pysmi before
# it ever binds a port. Declared here until upstream does.
pysmi>=1.3.0
